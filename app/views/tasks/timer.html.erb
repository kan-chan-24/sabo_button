<div class="container mx-auto px-4 py-4 md:py-8">
  <div class="max-w-md mx-auto text-center">

    <!-- 応援メッセージ:スマホでは小さめ、PCでは大きく -->
    <div class="mb-6 md:mb-8">
      <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-gray-800 mb-3 md:mb-4">
        じゃあ3分だけやろう！
      </h1>
      <p class="text-base md:text-lg lg:text-xl text-gray-600 px-2">
        <%= @task.name %>
      </p>
    </div>

    <!-- タイマー表示:スマホでも見やすい大きさに -->
    <div class="bg-white rounded-lg shadow-lg p-8 md:p-12 mb-6 md:mb-8">
      <div id="timer" class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold text-blue-600">
        03:00
      </div>
    </div>

    <!-- 完了ボタン:スマホでもタップしやすいサイズに -->
    <%= form_with url: complete_task_path(@task), method: :patch, local: true do %>
      <button 
        type="submit" 
        id="complete-btn"
        class="w-full px-6 md:px-8 py-3 md:py-4 bg-green-500 text-white text-lg md:text-xl font-bold rounded-lg hover:bg-green-600 transition disabled:bg-gray-400 disabled:cursor-not-allowed"
        disabled
      >
        <span class="hidden sm:inline">完了（タイマー終了後に押せます）</span>
        <span class="sm:hidden">完了（終了後に押せます）</span>
      </button>
    <% end %>

    <!-- 戻るリンク:スマホでもタップしやすく -->
    <div class="mt-4 md:mt-6">
      <%= link_to "タスク一覧に戻る", tasks_path, 
          class: "inline-block text-sm md:text-base text-blue-500 hover:text-blue-700 py-2 px-4" %>
    </div>
  </div>
</div>

<script>
    // Turboでページが読み込まれた時に実行
    document.addEventListener('turbo:load', function() {
    // 既存のタイマーがあればクリア
    if (window.currentTimer) {
      clearInterval(window.currentTimer);
    }

    let timeLeft = 180;
    const timerDisplay = document.getElementById('timer');
    const completeBtn = document.getElementById('complete-btn');

    // タイマーの要素が存在しない場合は処理を中断
    if (!timerDisplay || !completeBtn) {
      return;
    }

    function formatTime(seconds) {
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = seconds % 60;
      return `${String(minutes).padStart(2, '0')}:${String(remainingSeconds).padStart(2, '0')}`;
    }

    function updateTimer() {
      timerDisplay.textContent = formatTime(timeLeft);
      
      if (timeLeft <= 0) {
        clearInterval(window.currentTimer);
        timerDisplay.textContent = '00:00';
        completeBtn.disabled = false;
        completeBtn.textContent = '完了!お疲れ様です!';
        completeBtn.classList.remove('bg-gray-400');
        completeBtn.classList.add('bg-green-500');
      } else {
        timeLeft--;
      }
    }

    window.currentTimer = setInterval(updateTimer, 1000);
  });

  // ページ離脱時のクリーンアップ
  document.addEventListener('turbo:before-render', function() {
    if (window.currentTimer) {
      clearInterval(window.currentTimer);
    }
  });
</script>